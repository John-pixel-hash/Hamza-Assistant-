# ============================================================================
# Hamza Assistant - environment template
# Copy to .env.local and fill in. Never commit the filled version.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# From Supabase: Project Settings, API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public key. Safe in the browser, it only reaches what row level security allows.
# New Supabase projects call this the publishable key (sb_publishable_...).
# Older projects call it the anon key (a long string starting with eyJ).
# Either name works. Do not set both to different values.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
# Server only, never sent to the browser. New projects call this the secret key
# (sb_secret_...), older ones the service role key. Bypasses row level security.
SUPABASE_SECRET_KEY=your-secret-key

# --- The single allowed account --------------------------------------------
# Any other signed in identity is rejected by the proxy and signed out.

# FIRST RUN ONLY: set ALLOW_SIGNUP=true and leave ALLOWED_EMAIL empty, open
# /setup, create your account, then come back here and do step 2 below.
ALLOW_SIGNUP=false

# STEP 2 (immediately after creating your account): put your email here and
# set ALLOW_SIGNUP=false. From this moment the system has exactly one door.
ALLOWED_EMAIL=you@example.com

# --- AI providers -----------------------------------------------------------
# Primary: Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key

# Add these when you want a second provider or a fallback chain.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model routing lives in the database (task_routing table), not here, so it can
# be changed without a redeploy. Default provider only:
DEFAULT_AI_PROVIDER=google

# --- Web research -----------------------------------------------------------
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-key
# BRAVE_API_KEY=

# --- Guardrails and cost controls -------------------------------------------
# Hard stop on AI calls per hour, protects your API balance from a stuck loop.
RATE_LIMIT_AI_CALLS_PER_HOUR=120
RATE_LIMIT_RESEARCH_PER_HOUR=40

# Tone gate: drafts scoring below this get one automatic rewrite.
TONE_SCORE_THRESHOLD=7

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Hamza Assistant
